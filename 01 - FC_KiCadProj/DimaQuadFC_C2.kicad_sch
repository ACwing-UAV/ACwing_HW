  (text "Pin map (IEKF firmware), rev C2:\nMotor PWM: M1 PA0 TIM2_CH1, M2 PB3 TIM2_CH2,\n  M3 PA6 TIM16_CH1, M4 PA10 TIM1_CH3\nLED: front PE4, rear PB1 (GPIO)\nNo LSE: RF wake-up HSE/1024, RTC HSE/32\nADC: PA5 VBAT_SNS (IN10), PA4 VBUS_DET (IN9)\nI2C1 PB8/PB9 -> LSM6DSV16X (Mode 3)\nIMU_INT1 PA15, IMU_INT2 PB4, MAG_DRDY PB5, BARO_INT PB0\nUSART1 PB6/PB7 -> TP1/TP2 (pogo), USB PA11/PA12\nSWD PA13/PA14, BOOT0 = PH3 (pull-down 10k)"
    (at 186.69 17.78 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid "27b65079-13e8-551f-88f1-8123a047c631"))
